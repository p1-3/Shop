-- ขับตามเส้นทาง
------------------------------------------------------------
local LEAD = 0.05 -- เริ่ม Tween ก้าวถัดไปก่อนก้าวเดิมจบ เพื่อไม่ให้รถสะดุด

local function zeroVelocity(roots)
	for _, r in ipairs(roots) do
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
	end
end

-- guard = true: ตรวจสิ่งกีดขวางใหม่ระหว่างขับ (รถ/NPC มาขวาง) แล้ววางแผนใหม่
-- คืนค่า: result ("arrived"|"stopped"|"skipped"|"lost"|"dead"|"unseated"|"replan"), CFrame สุดท้าย
local function driveRoute(vehicle, myId, path, label, guard)
	local pivot = vehicle:GetPivot()
	local planS = 0
	local planAlt = pivot.Position.Y
	local _, t0 = pathAt(path, 0)
	local heading = flatUnit((pivot * CFrame.Angles(0, -math.rad(yawOffset), 0)).LookVector) or t0
	local pitchS, leanS = 0, 0
	local result = "stopped"
	local tween
	local unseatedAt
	local lastStream = 0
	local blockedCount = 0
	local endY = path.pts[#path.pts].Y

	local cfv = Instance.new("CFrameValue")
	cfv.Value = pivot
	local roots = collectRoots(vehicle)
	local conn = cfv.Changed:Connect(function(v)
		vehicle:PivotTo(v)
		zeroVelocity(roots)
	end)
	local function cleanup()
		if tween then tween:Cancel() end
		conn:Disconnect()
	end
	S.cleanup = cleanup

	while S.running and S.runId == myId do
		if S.skip then
			S.skip = false
			result = "skipped"
			break
		end
		if not vehicle.Parent then
			result = "lost"
			break
		end
		if not isAlive() then
			result = "dead"
			break
		end
		local now = os.clock()
		if isSeatedIn(vehicle) then
			unseatedAt = nil
		else
			unseatedAt = unseatedAt or now
			if now - unseatedAt > 1.5 then
				result = "unseated"
				break
			end
		end
		-- ถูกเซิร์ฟเวอร์ดีดกลับ/รถเพี้ยนตำแหน่ง -> คำนวณทางใหม่
		if (vehicle:GetPivot().Position - cfv.Value.Position).Magnitude > 20 then
			result = "replan"
			break
		end

		local dt = CONFIG.StepTime
		local remaining = path.len - planS
		setProgress(label, remaining)
		if remaining <= 1 then
			result = "arrived"
			break
		end

		-- ความเร็ว: ช้าลงตอนโค้ง/ใกล้ถึง
		local curveAng = 0
		if not path.flyover then
			local _, t1 = pathAt(path, planS)
			local _, t2 = pathAt(path, math.min(planS + 14, path.len))
			curveAng = math.abs(signedAngle(t1, t2))
		end
		local speedMul = math.clamp(1 - curveAng / math.rad(100), 0.35, 1)
		local slow = math.clamp(remaining / 25, 0.3, 1)
		local effSpeed = math.max(CONFIG.Speed * speedMul * slow, 4)
		local stepDist = math.min(effSpeed * dt, remaining)
		local nextS = planS + stepDist

		local np = pathAt(path, nextS)
		local _, aheadTan = pathAt(path, math.min(nextS + 3, path.len))
		local newHeading = turnToward(heading, aheadTan, CONFIG.TurnRate * dt)

		-- ตรวจของมาขวางข้างหน้า (เสา/รถ/NPC ที่เพิ่งเข้ามา)
		if guard and not path.flyover then
			local lookS = math.min(planS + math.max(stepDist * 2, 6), path.len)
			local lp = pathAt(path, lookS)
			if volumeFree(lp.X, lp.Z, planAlt - hoverNow()) then
				blockedCount = 0
			else
				blockedCount += 1
			end
			if blockedCount >= 3 then
				result = "replan"
				break
			end
		end

		-- แผนความสูง
		local s, B, gpts, gdirs = planProfile(path, planS, planAlt)
		local nextAlt = altAt(s, B, stepDist)
		local topY
		if path.flyover then
			topY = (remaining > 25) and (math.max(planAlt, endY) + CONFIG.ScanHeight) or (endY + hoverNow() + scanUp())
		else
			topY = math.max(planAlt, nextAlt) + scanUp()
		end
		local gr = Workspace:Raycast(Vector3.new(np.X, topY, np.Z), Vector3.new(0, -3000, 0), rayParams)
		local groundN = gr and gr.Position.Y or (nextAlt - hoverNow())
		nextAlt = math.max(nextAlt, groundN + hoverNow())
		lastExtra = math.max(nextAlt - (groundN + hoverNow()), 0)
		updateTrimText()

		-- เงยหัว/ก้มหัวตามเส้นทาง + เอียงตัวตอนเลี้ยว (เฉพาะรถแคบ)
		if stepDist > 0.3 then
			local pitchT = math.clamp(math.atan2(nextAlt - planAlt, stepDist), -0.8, 0.8)
			pitchS = pitchS + (pitchT - pitchS) * 0.4
		end
		local leanT = 0
		if V.lean then
			leanT = math.clamp(signedAngle(heading, newHeading) / dt * 0.12, -0.4, 0.4)
		end
		leanS = leanS + (leanT - leanS) * 0.3

		local nextPos = Vector3.new(np.X, nextAlt, np.Z)
		local fwd = Vector3.new(newHeading.X * math.cos(pitchS), math.sin(pitchS), newHeading.Z * math.cos(pitchS))
		local newCF = CFrame.lookAt(nextPos, nextPos + fwd)
			* CFrame.Angles(0, 0, leanS)
			* CFrame.Angles(0, math.rad(yawOffset), 0)

		S.guidePts = gpts
		S.guideDirs = gdirs

		if nextAlt - (groundN + hoverNow()) > 2.5 then
			setStatus("🛫 ยกรถข้าม → " .. label)
		else
			setStatus((path.flyover and "✈ บินตรง → " or "🏍️ กำลังไป → ") .. label)
		end

		-- โหลดแผนที่ข้างหน้า (กรณีเปิด StreamingEnabled)
		if Workspace.StreamingEnabled and now - lastStream > 1 then
			lastStream = now
			local ahead = gpts[#gpts]
			task.spawn(function()
				pcall(function() Workspace:RequestStreamAroundAsync(ahead, 0.4) end)
			end)
		end

		-- Tween ต่อเนื่อง: เริ่มก้าวใหม่ตอนก้าวเก่ายังไม่จบ (ความเร็วคงที่ ไม่สะดุด)
		local dist3 = (nextPos - cfv.Value.Position).Magnitude
		local T = math.max(dist3 / effSpeed, 0.04)
		if tween then tween:Cancel() end
		tween = TweenService:Create(cfv, TweenInfo.new(T, Enum.EasingStyle.Linear), { Value = newCF })
		tween:Play()

		planS, planAlt, heading = nextS, nextAlt, newHeading
		advanceBase(path, planS)
		task.wait(math.max(T - LEAD, 0.02))
	end

	if result == "arrived" and tween and tween.PlaybackState == Enum.PlaybackState.Playing then
		tween.Completed:Wait()
	end
	local finalCF = cfv.Value
	cleanup()
	cfv:Destroy()
	if S.cleanup == cleanup then S.cleanup = nil end
	return result, finalCF
end

-- ค้างรถไว้ที่ตู้ตามเวลาที่ตั้ง (กดข้ามเพื่อไปต่อทันที)
local function holdVehicle(vehicle, cf, seconds, myId, label)
	if seconds <= 0 then return end
	local roots = collectRoots(vehicle)
	local t0 = os.clock()
	while S.running and S.runId == myId and vehicle.Parent do
		local left = seconds - (os.clock() - t0)
		if left <= 0 or S.skip then break end
		vehicle:PivotTo(cf)
		zeroVelocity(roots)
		setStatus(("🏧 ถึง %s แล้ว • รอ %d วิ"):format(label, math.ceil(left)))
		RunService.Heartbeat:Wait()
	end
	S.skip = false
end

-- ไป 1 ตู้: หาจุดจอด -> เส้นหยาบ -> ตรวจ/ซ่อมสิ่งกีดขวาง -> ขับ -> ค้าง
local function runLeg(vehicle, atm, myId)
	prepareVehicle(vehicle)
	S.vehicle = vehicle
	local label = atm.Name
	local function aborted() return not (S.running and S.runId == myId) end

	if Workspace.StreamingEnabled then
		setStatus("📡 โหลดแผนที่รอบ " .. label)
		pcall(function() Workspace:RequestStreamAroundAsync(atm:GetPivot().Position, 3) end)
		if aborted() then return "stopped" end
	end

	local stand, quality = computeStand(atm, vehicle)
	if quality == "side" then
		label = label .. " (ข้าง)"
	elseif quality == "back" then
		label = label .. " (หลัง)"
	elseif quality == "weak" then
		label = label .. " (เดาจุด)"
	end
	showMarker(stand)

	local attempts = 0
	while not aborted() do
		attempts += 1
		local pivot = vehicle:GetPivot()
		local fy = floorAt(pivot.Position.X, pivot.Position.Z, pivot.Position.Y - hoverNow())
			or (pivot.Position.Y - hoverNow())
		local from = Vector3.new(pivot.Position.X, fy, pivot.Position.Z)

		setStatus("🧭 หาเส้นทางไป " .. label)
		local coarse = computeCoarse(from, stand) or { from, stand }
		if aborted() then return "stopped" end

		setStatus("🔍 ตรวจสิ่งกีดขวางทั้งเส้นทาง...")
		local ok, refined, info = pcall(refineRoute, coarse, aborted)
		if aborted() then return "stopped" end

		local path
		local lbl = label
		if ok and refined then
			path = finalizePath(refined, info.unresolved > 0)
			if info.partial then lbl = label .. " (เข้าไม่ถึง)" end
		else
			-- ตัวตรวจพัง: ใช้เส้นหยาบแบบบินข้ามแทน
			path = finalizePath(coarse, true)
		end

		local result, finalCF = driveRoute(vehicle, myId, path, lbl, attempts < 4)
		if result == "replan" then
			if attempts >= 5 then
				hideMarker()
				return "skipped"
			end
			setStatus("↩ มีของขวาง/ถูกดีด วางแผนใหม่")
			task.wait(0.3)
		elseif result == "arrived" then
			holdVehicle(vehicle, finalCF, CONFIG.DwellTime, myId, lbl)
			hideMarker()
			return "arrived"
		else
			if result ~= "stopped" then hideMarker() end
			return result
		end
	end
	return "stopped"
end

