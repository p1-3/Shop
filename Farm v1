	-- ตัวควบคุมลำดับงานหลัก
	------------------------------------------------------------
	local stats = { hacks = 0 }
	local badUntil = {}   -- ตู้ที่เพิ่งแฮก/แฮกไม่ผ่าน พักสั้น ๆ กันวนซ้ำ
	local buyFails = 0
	local mainToggle, syncing = nil, false

	local function stopAll(msg)
		local was = Cfg.Active
		Cfg.Active = false
		Cfg.Manual = false
		Drive.stop()
		_G.AtmHack_Active = false
		if msg then
			say(msg)
			notify("Auto ATM Hub", msg)
		end
		if was and mainToggle then
			syncing = true
			pcall(function() mainToggle:Set(false) end)
			syncing = false
		end
	end

	local function myPos()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		return hrp and hrp.Position or Vector3.zero
	end

	-- ตู้พร้อมแฮกไหม (อ่านสดจาก ProximityPrompt.Enabled) — ใช้ได้จริงเฉพาะตอน "ไม่ได้นั่งรถ"
	-- เพราะตอนนั่งรถ ปุ่มของทุกตู้จะถูกปิด (แดงหมด)
	local function atmReadyLive(atm)
		local ready = false
		local part = atm:FindFirstChild("Part")
		local pr = part and part:FindFirstChild("ProximityPrompt")
		if pr and pr:IsA("ProximityPrompt") then ready = pr.Enabled end
		if not ready then
			local fb = atm:FindFirstChildWhichIsA("ProximityPrompt", true)
			if fb then ready = fb.Enabled end
		end
		return ready
	end

	local function isSeated()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and hum.SeatPart ~= nil
	end

	-- จำสถานะตู้ไว้ตอนยืนเดิน แล้วใช้ค่าที่จำไว้ตอนนั่งรถ
	-- คืน true (พร้อม) / false (ไม่พร้อม) / nil (ไม่รู้ → ถือว่าลองไปดูได้)
	local readyCache = {}
	local function atmState(atm)
		local key = Drive.atmKey(atm)
		if not isSeated() then
			local r = atmReadyLive(atm)
			readyCache[key] = { ready = r, t = os.clock() }
			return r
		end
		local c = readyCache[key]
		if not c then return nil end
		if not c.ready and os.clock() - c.t > 45 then return nil end -- ข้อมูล "ไม่พร้อม" เก่าเกิน 45 วิ ให้ไปเช็กใหม่
		return c.ready
	end

	-- ตู้ใกล้สุด (forHack = ข้ามตู้ที่รู้ว่าไม่พร้อม; ฝาก/ถอนใช้ตู้ไหนก็ได้ที่ใกล้สุด)
	local function pickATM(fromPos, forHack)
		local best, bd
		local now = os.clock()
		for _, a in ipairs(Drive.collectATMs()) do
			local skip = false
			if forHack then
				local bu = badUntil[Drive.atmKey(a)]
				skip = (bu and bu > now) or atmState(a) == false
			end
			if not skip then
				local d = Drive.flatDist(a:GetPivot().Position, fromPos)
				if not bd or d < bd then best, bd = a, d end
			end
		end
		return best
	end

	local function updateHighlights()
		for _, atm in ipairs(Drive.collectATMs()) do
			local h = atm:FindFirstChild("PromptStatusHighlight")
			if not h then
				h = Instance.new("Highlight")
				h.Name = "PromptStatusHighlight"
				h.Adornee = atm
				h.Parent = atm
			end
			local st = atmState(atm)
			h.FillColor = (st == true and Color3.fromRGB(0, 255, 0))
				or (st == false and Color3.fromRGB(255, 0, 0))
				or Color3.fromRGB(255, 170, 0) -- ส้ม = ยังไม่รู้สถานะ (ยังไม่เคยดูตอนยืนเดิน)
			h.OutlineColor = Color3.fromRGB(255, 255, 255)
