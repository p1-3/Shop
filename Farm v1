-- วางแผนความสูงข้างหน้าตามเส้นทาง (ยกรถข้ามของเตี้ย / ลดระดับลง)
------------------------------------------------------------
local function planProfile(path, s0, startAlt)
	local spacing = CONFIG.ProfileSpacing
	local remaining = path.len - s0
	local total = math.min(math.clamp(100 + CONFIG.Speed, 100, 280), remaining)
	local n = math.max(1, math.ceil(total / spacing))
	local endFloor = path.pts[#path.pts].Y
	local flyTop = path.flyover and (math.max(startAlt, endFloor) + CONFIG.ScanHeight) or nil

	local s, hs, spos, sdir = {}, {}, {}, {}
	local hv = hoverNow()
	local lastH = startAlt - hv
	for j = 0, n do
		local d = math.min(j * spacing, total)
		local p, tan = pathAt(path, s0 + d)
		local topY
		if flyTop and (path.len - (s0 + d)) > 25 then
			topY = flyTop
		elseif path.flyover then
			topY = endFloor + hv + scanUp() -- ใกล้จุดจอด: มองพื้นระดับเดียวกับตู้ ไม่มองหลังคา
		else
			topY = lastH + hv + scanUp()
		end
		local r = Workspace:Raycast(Vector3.new(p.X, topY, p.Z), Vector3.new(0, -3000, 0), rayParams)
		local h = r and r.Position.Y or lastH
		lastH = h
		s[j + 1] = d
		hs[j + 1] = h
		spos[j + 1] = p
		sdir[j + 1] = tan
	end

	local count = n + 1
	local need = table.create(count)
	for k = 1, count do
		local edge = false
		if k > 1 and k < count then
			local d2 = hs[k + 1] - 2 * hs[k] + hs[k - 1]
			if math.abs(d2) > 1.5 then edge = true end
		end
		if k > 1 and math.abs(hs[k] - hs[k - 1]) > 3.5 then edge = true end
		if k < count and math.abs(hs[k + 1] - hs[k]) > 3.5 then edge = true end
		need[k] = hs[k] + hv + ((k > 1 and edge) and CONFIG.Margin or 0)
	end

	local A = table.create(count)
	A[count] = need[count]
	for k = count - 1, 1, -1 do
		A[k] = math.max(need[k], A[k + 1] - (s[k + 1] - s[k]) * CONFIG.ClimbSlope)
	end
	local B = table.create(count)
	B[1] = startAlt
	for k = 2, count do
		B[k] = math.max(A[k], B[k - 1] - (s[k] - s[k - 1]) * CONFIG.DescendSlope)
	end

	local gpts = table.create(count)
	for k = 1, count do
		gpts[k] = Vector3.new(spos[k].X, B[k], spos[k].Z)
	end
	return s, B, gpts, sdir
end

local function altAt(s, B, d)
	for k = 1, #s - 1 do
		if d <= s[k + 1] then
			local t = (d - s[k]) / math.max(s[k + 1] - s[k], 1e-4)
			return B[k] + (B[k + 1] - B[k]) * math.clamp(t, 0, 1)
		end
	end
	return B[#B]
end

