	local function exitSeat()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or not hum.SeatPart then return true end
		say("ลงจากรถ...")
		NetGet("exit_seat")
		for _ = 1, 10 do
			if not hum.SeatPart then return true end
			task.wait(0.1)
		end
		pcall(function()
			hum.Sit = false
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end)
		task.wait(0.3)
		return hum.SeatPart == nil
	end

	-- ขึ้นรถ (ถ้ายังไม่ได้นั่ง) แล้วรันงานขับ fn(vehicle) ลองสูงสุด 3 ครั้ง
	local function driveTo(fn)
		for _ = 1, 3 do
			if not alive() then return false end
			if not Veh.ensureSeated() then return false end
			local vehicle = Drive.getMyVehicle()
			if vehicle then
				local res = fn(vehicle)
				if res == "arrived" or res == "skipped" then return true end
				if res == "stopped" then return false end
				say("เส้นทางมีปัญหา (" .. tostring(res) .. ") ลองใหม่...")
			end
			task.wait(1)
		end
		return false
	end

	local function visitATM(atm)
		say("ขับไป " .. atm.Name)
		if not driveTo(function(v) return Drive.goToATM(v, atm) end) then return false end
		exitSeat()
		return true
	end

	local function hackAt(atm)
		if not alive() then return end
		say("กำลังแฮก " .. atm.Name .. " ด้วย " .. Cfg.Chip)
		local seen = Hack.run(Cfg.Chip, atm)
		badUntil[Drive.atmKey(atm)] = os.clock() + (seen and 5 or 20)
		readyCache[Drive.atmKey(atm)] = { ready = false, t = os.clock() }
		if seen then
			stats.hacks += 1
			say("แฮกเสร็จ (รวม " .. stats.hacks .. " ครั้ง)")
		else
			say("แฮกไม่สำเร็จ — จะลองตู้อื่นที่พร้อม")
		end
	end

	-- 1 รอบการทำงาน
	local function cycle()
		-- 1) เสก/ขึ้นรถ
		if not Veh.ensureSeated() then task.wait(1.5) return end

		-- 2) เช็กชิป
		local chip = Cfg.Chip
		if countItem(chip) <= 0 then
			local qty = math.max(1, math.floor(Cfg.BuyQty))
			local cost = (CHIP_PRICE[chip] or 0) * qty
			local hand, bank = getMoney()
			say(("ไม่มี %s • ซื้อ %d ชิ้น = $%s (มือ $%s / ธนาคาร $%s)"):format(chip, qty, fmt(cost), fmt(hand), fmt(bank)))

			if hand + bank < cost then
				stopAll(("เงินรวมไม่พอซื้อ %s ×%d (ต้องการ $%s มี $%s)"):format(chip, qty, fmt(cost), fmt(hand + bank)))
				return
			end

			-- เงินในตัวไม่พอ → ไป ATM ใกล้สุด ถอนให้พอดีค่าชิป
			if hand < cost then
				local atm = pickATM(myPos(), false)
				if not atm then stopAll("ไม่พบตู้ ATM (Workspace.Map.Props.ATMs)") return end
				if not visitATM(atm) then return end
				local need = math.ceil(cost - hand)
				say("ถอนเงิน $" .. fmt(need))
				if not Bank.withdraw(need) then
					stopAll("ถอนเงินไม่สำเร็จ (transfer_funds bank→hand)")
					return
				end
				task.wait(0.5)
				if not Veh.ensureSeated() then return end
			end

			-- ไปจุดซื้อชิป
			say("ขับไปจุดซื้อชิป")
			if not driveTo(function(v) return Drive.goToPoint(v, Cfg.ShopPoint, "จุดซื้อชิป") end) then return end
			exitSeat()
			local shop
			waitUntil(function()
				shop = Workspace:FindFirstChild("ShopZone_Illegal")
				return shop ~= nil
			end, 5)
			if not shop then stopAll("ไม่พบ workspace.ShopZone_Illegal") return end

			local got = Bank.buy(chip, qty, shop)
			if got <= 0 then
				buyFails += 1
				if buyFails >= 2 then
					stopAll("ซื้อชิปไม่ผ่าน 2 ครั้ง — เช็กเงิน/จุดซื้อ")
				end
				return
			end
			buyFails = 0
			say(("ซื้อได้ %d/%d ชิ้น"):format(got, qty))

			-- เงินในตัวเหลือ → ไปฝากที่ ATM ใกล้สุด แล้วแฮกต่อทันทีถ้าตู้นั้นพร้อม
			local leftover = math.floor((getMoney()) - Cfg.KeepOnHand)
			if Cfg.AutoDeposit and leftover > 0 then
				local atm = pickATM(myPos(), false)
				if atm and visitATM(atm) then
					say("ฝากเงินที่เหลือ $" .. fmt(leftover))
					if not Bank.deposit(leftover) then
						notify("ฝากเงินไม่สำเร็จ", "ข้ามไปแฮกต่อ")
					end
					task.wait(0.5)
					if atmReadyLive(atm) then
						hackAt(atm)
						return
					end
				end
			end
		end

		-- 3) มีชิป → ไป ATM ที่พร้อมแฮกและใกล้สุด → ลงจากรถ → แฮก
		if not alive() then return end
		local atm = pickATM(myPos(), true)
		if not atm then
			say("ไม่มีตู้ที่พร้อมแฮก (แดงทุกตู้) รอสักครู่...")
			task.wait(2)
			return
		end
		if not visitATM(atm) then return end
		-- ลงรถแล้วปุ่มตู้จึงกลับมาอ่านได้จริง: ถ้ายังแดงอยู่ (ถูกแฮกไปแล้ว/ยังพัก) ข้ามไปตู้อื่น
		if not waitUntil(function() return atmReadyLive(atm) end, 2.5) then
			local key = Drive.atmKey(atm)
			badUntil[key] = os.clock() + 10
			readyCache[key] = { ready = false, t = os.clock() }
			say(atm.Name .. " ยังไม่พร้อม (แดง) — ไปตู้อื่น")
			return
		end
		hackAt(atm)
	end

	local function startLoop()
		if Cfg.Active then return end
		Cfg.Manual = false
		Cfg.Active = true
		buyFails = 0
		task.spawn(function()
			say("เริ่มระบบอัตโนมัติ")
			while Cfg.Active and not Cfg.Destroyed do
				local ok, err = pcall(cycle)
				if not ok then
					warn("[AutoATM] " .. tostring(err))
					say("ผิดพลาด: " .. tostring(err))
					task.wait(2)
				end
				task.wait(0.3)
			end
			Drive.stop()
		end)
	end

	local function runManual(name, fn)
		if Cfg.Active or Cfg.Manual then
			notify("กำลังทำงานอยู่", "กดหยุดก่อนค่อยทดสอบ")
			return
		end
		Cfg.Manual = true
		task.spawn(function()
			local ok, err = pcall(fn)
			if not ok then warn("[AutoATM] " .. tostring(err)) end
			Cfg.Manual = false
			Drive.stop()
			say(name .. " จบแล้ว")
		end)
	end

