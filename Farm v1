-- เพิ่มใหม่: ขับไปยังจุดที่กำหนด (ใช้ระบบหาเส้นทาง/หลบสิ่งกีดขวางชุดเดียวกับ runLeg)
------------------------------------------------------------
local function runToPoint(vehicle, point, label, myId)
	prepareVehicle(vehicle)
	S.vehicle = vehicle
	local function aborted() return not (S.running and S.runId == myId) end

	-- ยึดจุดหมายกับพื้น (พิกัดที่ให้มาอาจเป็นความสูงตัวละคร จึงลองหลายระดับ)
	local stand
	for _, dy in ipairs({ 0, -3, -1.5, -5 }) do
		local fy = floorAt(point.X, point.Z, point.Y + dy)
		if fy then
			stand = Vector3.new(point.X, fy, point.Z)
			break
		end
	end
	stand = stand or Vector3.new(point.X, point.Y - 3, point.Z)

	if Workspace.StreamingEnabled then
		setStatus("📡 โหลดแผนที่รอบ " .. label)
		pcall(function() Workspace:RequestStreamAroundAsync(stand, 3) end)
		if aborted() then return "stopped" end
	end
	showMarker(stand)

	local attempts = 0
	while not aborted() do
		attempts += 1
		local pivot = vehicle:GetPivot()
		local fy = floorAt(pivot.Position.X, pivot.Position.Z, pivot.Position.Y - hoverNow())
			or (pivot.Position.Y - hoverNow())
		local from = Vector3.new(pivot.Position.X, fy, pivot.Position.Z)

		setStatus("🧭 หาเส้นทางไป " .. label)
		local coarse = computeCoarse(from, stand) or { from, stand }
		if aborted() then return "stopped" end

		setStatus("🔍 ตรวจสิ่งกีดขวางทั้งเส้นทาง...")
		local ok, refined, info = pcall(refineRoute, coarse, aborted)
		if aborted() then return "stopped" end

		local path
		local lbl = label
		if ok and refined then
			path = finalizePath(refined, info.unresolved > 0)
			if info.partial then lbl = label .. " (เข้าไม่ถึง)" end
		else
			path = finalizePath(coarse, true)
		end

		local result, finalCF = driveRoute(vehicle, myId, path, lbl, attempts < 4)
		if result == "replan" then
			if attempts >= 5 then
				hideMarker()
				return "skipped"
			end
			setStatus("↩ มีของขวาง/ถูกดีด วางแผนใหม่")
			task.wait(0.3)
		elseif result == "arrived" then
			holdVehicle(vehicle, finalCF, CONFIG.DwellTime, myId, lbl)
			hideMarker()
			return "arrived"
		else
			if result ~= "stopped" then hideMarker() end
			return result
		end
	end
	return "stopped"
end

-- รันงานขับ 1 งานแบบรอจนจบ (คืน "arrived" | "skipped" | "stopped" | "lost" | "dead" | "unseated" | "error")
local function runSync(fn)
	S.running = true
	S.runId += 1
	local myId = S.runId
	S.skip = false
	local ok, res = pcall(fn, myId)
	if S.runId == myId then
		S.running = false
		if S.cleanup then
			local c = S.cleanup
			S.cleanup = nil
			pcall(c)
		end
		S.guidePts, S.guideDirs = nil, nil
		hideGuide()
		hideMarker()
	end
	if not ok then
		warn("[Drive] " .. tostring(res))
		return "error"
	end
	return res
end

function Drive.goToATM(vehicle, atm)
	return runSync(function(myId) return runLeg(vehicle, atm, myId) end)
end

function Drive.goToPoint(vehicle, point, label)
	return runSync(function(myId) return runToPoint(vehicle, point, label or "จุดหมาย", myId) end)
end

function Drive.stop()
	S.running = false
	S.runId += 1
	if S.cleanup then
		local c = S.cleanup
		S.cleanup = nil
		pcall(c)
	end
	S.guidePts, S.guideDirs = nil, nil
	hideGuide()
	hideMarker()
end

