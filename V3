		Value = { Min = 0, Max = 5000, Default = Cfg.KeepOnHand },
		Callback = function(v) Cfg.KeepOnHand = math.floor(v) end,
	})
	TabMain:Toggle({
		Title = "ซ่อมพาหนะอัตโนมัติเมื่อ HP = 0",
		Value = Cfg.AutoRepair,
		Callback = function(v) Cfg.AutoRepair = v end,
	})
	TabMain:Toggle({
		Title = "ไฮไลต์ตู้ ATM",
		Value = Cfg.HighlightATM,
		Callback = function(v)
			Cfg.HighlightATM = v
			if not v then pcall(clearHighlights) end
		end,
	})

	---------------- Tab ขับรถ ----------------
	local TabDrive = Window:Tab({ Title = "ขับรถ", Icon = "car" })
	local DC = Drive.CONFIG
	TabDrive:Slider({
		Title = "ความเร็ว (studs/s)",
		Step = 5,
		Value = { Min = DC.MinSpeed, Max = DC.MaxSpeed, Default = DC.Speed },
		Callback = function(v) DC.Speed = v end,
	})
	TabDrive:Slider({
		Title = "รอที่จุดหมาย (วินาที)",
