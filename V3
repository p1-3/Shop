	marker.Transparency = 0.45
end
local function hideMarker() marker.Transparency = 1 end
local function hideGuide() for _, p in ipairs(guideParts) do p.Transparency = 1 end end
local function updateGuide(carPos)
	local pts, dirs = S.guidePts, S.guideDirs
	if not guideEnabled or not pts or #pts == 0 then hideGuide() return end
	local line = { carPos }
	local started = false
	for k = 1, #pts do
		local p = pts[k]
		if not started then
			local d = dirs[k]
			if (p.X - carPos.X) * d.X + (p.Z - carPos.Z) * d.Z > 1.5 then started = true end
		end
		if started then
			line[#line + 1] = p
			if #line >= GUIDE_MAX + 1 then break end
		end
	end
	local count = #line
	for i = 1, GUIDE_MAX do
		local part = guideParts[i]
		local a, b = line[i], line[i + 1]
		if a and b and (b - a).Magnitude > 0.01 then
			local len = (b - a).Magnitude
			part.Size = Vector3.new(0.45, 0.45, len + 0.1)
			part.CFrame = CFrame.lookAt((a + b) / 2, b)
			part.Transparency = math.clamp((i - 1) / count * 0.85, 0, 0.85)
		else
			part.Transparency = 1
		end
	end
end

