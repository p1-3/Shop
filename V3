	local function findVehiclePromptInWorkspace(targetName)
		if not targetName then return nil end
		local targetNameLower = string.lower(targetName)
		local bestPrompt, bestDist = nil, nil
		local char, hrp = getCharData()
		if not hrp then return nil end
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent.Name == "DrivePromptAttachment" and obj.Enabled then
				local model = obj:FindFirstAncestorOfClass("Model")
				if model then
					local modelName = string.lower(model.Name)
					if string.find(modelName, targetNameLower) or string.find(targetNameLower, modelName) then
						local att = obj.Parent
						if att:IsA("Attachment") then
							local dist = (att.WorldPosition - hrp.Position).Magnitude
							if not bestDist or dist < bestDist then
								bestPrompt = obj
								bestDist = dist
							end
						end
					end
				end
			end
		end
		return bestPrompt
	end

	function Veh.ensureSeated(maxTries)
		for _ = 1, (maxTries or 6) do
			if not alive() then return false end
			local _, hrp, hum = getCharData()
			if hum and hrp and hum.Health > 0 then
				if hum.SeatPart then return true end
				say("กำลังสแกนหา [" .. Cfg.VehicleType .. "]...")
				local name, guid = ScanAndRememberVehicle(Cfg.VehicleType)
				if guid then
					local prompt = findVehiclePromptInWorkspace(name)
					if not prompt then
						say("กำลังสั่งเสกพาหนะ...")
						NetGet("toggle_equip_item", guid)
						task.wait(1.5)
						prompt = findVehiclePromptInWorkspace(name)
					end
					if prompt then
						say("กำลังวาปไปขึ้น [" .. tostring(name) .. "]...")
						local att = prompt.Parent
						if att and att:IsA("Attachment") then
							hrp.CFrame = CFrame.new(att.WorldPosition + Vector3.new(0, 3, 0))
							task.wait(0.2)
							if typeof(fireproximityprompt) == "function" then
								fireproximityprompt(prompt)
							else
								prompt:InputHoldBegin()
								task.wait(prompt.HoldDuration + 0.05)
								prompt:InputHoldEnd()
							end
							task.wait(0.5)
						end
					else
						say("รอคูลดาวน์ / ไม่พบพาหนะในแมพ...")
					end
				else
					say("ไม่พบ " .. Cfg.VehicleType .. " ในกระเป๋าของคุณ!")
				end
			end
			task.wait(1)
		end
		local _, _, hum = getCharData()
		return hum ~= nil and hum.SeatPart ~= nil
	end

	local function scanVehicleData(searchType)
		local rName, rGuid, rData
		pcall(function()
			if not (DataModule and DataModule.items) then return end
			for catName, catContent in pairs(DataModule.items) do
				local lowerCat = string.lower(tostring(catName))
				local match
				if searchType == "bike" then
					match = string.find(lowerCat, "bike") ~= nil or string.find(lowerCat, "bicycle") ~= nil
				else
					match = (string.find(lowerCat, "car") ~= nil or string.find(lowerCat, "vehicle") ~= nil
						or string.find(lowerCat, "transport") ~= nil)
						and not string.find(lowerCat, "bike") and not string.find(lowerCat, "bicycle")
				end
				if match and type(catContent) == "table" then
					for itemName, itemTable in pairs(catContent) do
						if type(itemTable) == "table" then
							for _, itemData in ipairs(itemTable) do
								if type(itemData) == "table" and itemData.guid then
									rName, rGuid, rData = tostring(itemName), itemData.guid, itemData
									break
								end
							end
						end
						if rGuid then break end
					end
				end
				if rGuid then break end
			end
		end)
		return rName, rGuid, rData
	end

	function Veh.health()
		local name, _, d = scanVehicleData(Cfg.VehicleType)
		if not (name and d) then return nil end
		local cur = tonumber(d.health or d.hp or d.durability) or 0
		local max = tonumber(d.maxHealth or d.maxHp) or 100
		if max <= 0 then max = 100 end
		return math.floor(cur / max * 100), cur, max, name
	end

	function Veh.repair()
		local _, guid = scanVehicleData(Cfg.VehicleType)
		if not guid then return false end
		local g = tostring(guid)
		if not g:match("^%{") then g = "{" .. g .. "}" end
		return callGet("repair_vehicle", g)
	end
