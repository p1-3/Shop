local function GetATMFolder()
	local map = WS:FindFirstChild("Map")
	local props = map and map:FindFirstChild("Props")
	return props and props:FindFirstChild("ATMs")
end
local function GetATMPos(atm)
	local p = atm:IsA("BasePart") and atm or atm:FindFirstChildWhichIsA("BasePart")
	return p and p.Position
end
local function FindNearestATM()
	local folder = GetATMFolder()
	if not folder then return nil end
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local best, bd = nil, math.huge
	for _, atm in ipairs(folder:GetChildren()) do
		local p = GetATMPos(atm)
		if p then
			local d = (p - hrp.Position).Magnitude
			if d < bd then bd, best = d, atm end
		end
	end
	return best, bd
end

local function AutoHackATM(chipName, atmOverride)
	chipName = chipName or "HackToolBasic"
	if not Slider then warn("[ATM] ไม่พบโมดูลมินิเกม") return false end
	local atm = atmOverride or FindNearestATM()
	if not atm then warn("[ATM] ไม่เจอตู้") return false end
	local atmPos = GetATMPos(atm)
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or not atmPos then return false end

	local function tryWarp(dist)
		local dir = hrp.Position - atmPos
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
		local stopPos = atmPos + dir.Unit * dist + Vector3.new(0, 2, 0)
		hrp.CFrame = CFrame.new(stopPos, Vector3.new(atmPos.X, stopPos.Y, atmPos.Z))
		task.wait(0.4)
		return (hrp.Position - atmPos).Magnitude
	end

	local d = tryWarp(4.0)
	if d > 8 then d = tryWarp(3.5) end
	if d > 8 then d = tryWarp(3.0) end
	if d > 8 then d = tryWarp(2.5) end
	if d > 8 then d = tryWarp(4.5) end
	if d > 8 then d = tryWarp(5.0) end

	task.wait(0.4)
	d = (hrp.Position - atmPos).Magnitude
	print(("[ATM] ระยะหลังวาป: %.2f studs"):format(d))
	if d > 8 then
		warn("[ATM] ยังไกลเกินไป — ข้าม")
		return false
	end

	_G.AtmHack_Active = true
	lastLevel = 0
	NetSend("request_begin_hacking_3", atm, chipName)

	local tStart = tick()
	local seen = false
	while tick() - tStart < 25 do
		if Slider.enabled.get() == true then
			seen = true
		elseif seen then
			break
		elseif (tick() - tStart) > 5 and not seen then
			warn("[ATM] มินิเกมไม่เปิดใน 5 วิ — server reject")
			break
		end
		task.wait(0.2)
	end

	_G.AtmHack_Active = false
	print("[ATM] จบรอบ | seen=" .. tostring(seen))
	return seen
end

