	TabDrive:Dropdown({
		Title = "ทิศหน้าตู้",
		Values = { "auto", "0", "90", "180", "270" },
		Value = "auto",
		Callback = function(v) Drive.setFront(tonumber(v)) end,
	})
	TabDrive:Button({
		Title = "หมุนหน้ารถ +90°",
		Callback = function() notify("หมุนหน้ารถ", Drive.rotateYaw() .. "°") end,
	})
	TabDrive:Button({
		Title = "จำจุดจอด (ตู้ที่ใกล้สุด)",
		Callback = function() Drive.recordStand() end,
	})
	TabDrive:Button({
		Title = "ล้างจุดจอดที่จำ",
		Callback = function() Drive.clearStands() end,
	})
	TabDrive:Space()

	TabDrive:Toggle({
		Title = "เดินทางใต้ดิน",
		Desc = "เปิด = ขับใต้ดิน (ล็อก Y) | ถึง ATM/ร้านค้าจะวาปขึ้นบนดินเอง แล้ววาปลงกลับเมื่อไปต่อ",
		Value = Cfg.UndergroundMode,
		Callback = function(v)
			Cfg.UndergroundMode = v
			Drive.setUnderground(v, Cfg.UndergroundY)
		end,
	})
	TabDrive:Slider({
		Title = "ระดับ Y ใต้ดิน (เดินทาง)",
		Step = 0.5,
		Value = { Min = 0, Max = 800, Default = Cfg.UndergroundY },
		Callback = function(v)
			Cfg.UndergroundY = v
			Drive.CONFIG.UndergroundY = v
			if Cfg.UndergroundMode then Drive.setUnderground(true, v) end
		end,
	})
	TabDrive:Slider({
		Title = "ระดับ Y บนดิน (fallback)",
		Step = 0.5,
		Value = { Min = 0, Max = 800, Default = 255 },
		Callback = function(v) Drive.CONFIG.GroundYFallback = v end,
	})
	TabDrive:Button({
		Title = "วาปรถขึ้นบนดินเดี๋ยวนี้",
		Callback = function()
			local v = Drive.getMyVehicle()
			if not v then notify("วาปขึ้น", "ไม่พบรถ") return end
			local pivot = v:GetPivot().Position
			local g = Drive.findGroundYAt(pivot.X, pivot.Z, pivot.Y) or Drive.CONFIG.GroundYFallback
			Drive.warpVehicleY(v, g + 3)
			notify("วาปขึ้น", ("Y = %.1f"):format(g + 3))
		end,
	})
	TabDrive:Button({
		Title = "วาปรถลงใต้ดินเดี๋ยวนี้",
		Callback = function()
			local v = Drive.getMyVehicle()
			if not v then notify("วาปลง", "ไม่พบรถ") return end
			Drive.warpVehicleY(v, Drive.CONFIG.UndergroundY)
			notify("วาปลง", ("Y = %.1f"):format(Drive.CONFIG.UndergroundY))
		end,
	})
	TabDrive:Space()

	TabDrive:Button({
		Title = "ทดสอบ: ขับไปจุดซื้อชิป",
		Callback = function()
			runManual("ขับไปจุดซื้อ", function()
				driveTo(function(v) return Drive.goToPoint(v, Cfg.ShopPoint, "จุดซื้อชิป") end)
			end)
		end,
	})
	TabDrive:Button({
		Title = "ทดสอบ: ขับไป ATM ใกล้สุด",
		Callback = function()
			runManual("ขับไป ATM", function()
				local atm = pickATM(myPos(), false)
				if atm then visitATM(atm) else say("ไม่พบตู้ ATM") end
			end)
		end,
	})
	TabDrive:Button({
		Title = "หยุดการทดสอบ / หยุดรถ",
		Color = Color3.fromHex("#c0392b"),
		Callback = function() stopAll("หยุดแล้ว") end,
	})

	---------------- Tab อื่น ๆ ----------------
	local TabMisc = Window:Tab({ Title = "อื่น ๆ", Icon = "settings" })
	TabMisc:Button({
		Title = "หยุดและปิดสคริปต์ทั้งหมด",
		Color = Color3.fromHex("#c0392b"),
		Callback = function()
			fullDestroy()
			pcall(function() Window:Destroy() end)
		end,
	})

	task.spawn(function()
		local lastS, lastM = "", ""
		local lastRepair = 0
		while not Cfg.Destroyed do
			local s = curStatus
			if progressText ~= "" and (Cfg.Active or Cfg.Manual) then s = s .. "  •  " .. progressText end
			if Cfg.UndergroundMode then s = "🚇 " .. s end
			if s ~= lastS then lastS = s setStatusUI(s) end

			local hand, bank = getMoney()
			local hp = ""
			local pct, cur, max, vname = Veh.health()
			if pct then hp = ("   ❤️ %s %d/%d"):format(vname, cur, max) end
			local m = ("💵 มือ $%s   🏦 ธนาคาร $%s   🎫 %s ×%d   ✅ แฮก %d ครั้ง%s"):format(
				fmt(hand), fmt(bank), Cfg.Chip, countItem(Cfg.Chip), stats.hacks, hp)
			if m ~= lastM then lastM = m setMoneyUI(m) end

			if Cfg.HighlightATM then
				pcall(updateHighlights)
			elseif not isSeated() then
				pcall(function()
					for _, a in ipairs(Drive.collectATMs()) do atmState(a) end
				end)
			end

			if Cfg.AutoRepair and pct and pct <= 0 and os.clock() - lastRepair > 3 then
				lastRepair = os.clock()
				task.spawn(function()
					if Veh.repair() then say("ซ่อมพาหนะสำเร็จ") else say("ซ่อมพาหนะไม่ผ่าน") end
				end)
			end
			task.wait(0.5)
		end
	end)

	genv.__AutoATM = { Destroy = fullDestroy }
	say("พร้อมใช้งาน — ตั้งค่าแล้วกด 'เริ่มระบบอัตโนมัติ'")
	notify("Auto ATM Hub", "โหลดเสร็จแล้ว (Patch A~G ครบ)")
end

