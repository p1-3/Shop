	})
	TabDrive:Slider({
		Title = "ปรับความสูงรถจากพื้น",
		Step = 0.5,
		Value = { Min = -3, Max = 5, Default = DC.HoverTrim },
		Callback = function(v) DC.HoverTrim = v end,
	})
	TabDrive:Toggle({
		Title = "ทะลุประตู",
