------------------------------------------------------------
local function buildPath(points, flyover)
	local pts, cum = { points[1] }, { 0 }
	for i = 2, #points do
		local p = points[i]
		local prev = pts[#pts]
		local d = flatDist(p, prev)
		if d > 0.5 then
			pts[#pts + 1] = p
			cum[#pts] = cum[#pts - 1] + d
		end
	end
	if #pts < 2 then
		pts[2] = pts[1] + Vector3.new(0, 0, -0.6)
		cum[2] = 0.6
	end
	return { pts = pts, cum = cum, len = cum[#pts], flyover = flyover, base = 1 }
end

local function pathAt(path, s)
	s = math.clamp(s, 0, path.len)
	local pts, cum = path.pts, path.cum
	local i = path.base
	if cum[i] > s then i = 1 end
	while i < #pts - 1 and cum[i + 1] < s do i += 1 end
	local a, b = pts[i], pts[i + 1]
	local segLen = cum[i + 1] - cum[i]
	local t = segLen > 1e-6 and (s - cum[i]) / segLen or 0
	return a:Lerp(b, t), flatUnit(b - a) or Vector3.new(0, 0, -1)
end

local function advanceBase(path, s)
	local cum = path.cum
	while path.base < #path.pts - 1 and cum[path.base + 1] < s do
		path.base += 1
	end
end

local function filletPoints(points, radius)
	if #points < 3 then return points end
	local out = { points[1] }
	for i = 2, #points - 1 do
		local P, A0, C0 = points[i], points[i - 1], points[i + 1]
		local v1 = Vector3.new(A0.X - P.X, 0, A0.Z - P.Z)
		local v2 = Vector3.new(C0.X - P.X, 0, C0.Z - P.Z)
		local l1, l2 = v1.Magnitude, v2.Magnitude
		if l1 < 0.5 or l2 < 0.5 then
			out[#out + 1] = P
		else
			local d = math.min(radius, l1 * 0.5, l2 * 0.5)
			local A = P + v1.Unit * d
			local C = P + v2.Unit * d
			for k = 0, 4 do
				local t = k / 4
				out[#out + 1] = A:Lerp(P, t):Lerp(P:Lerp(C, t), t)
			end
		end
	end
	out[#out + 1] = points[#points]
	return out
end

local function simplify(points)
	if #points <= 2 then return points end
	local out = { points[1] }
	for i = 2, #points - 1 do
		local a, b, c = out[#out], points[i], points[i + 1]
		local d1, d2 = flatUnit(b - a), flatUnit(c - b)
		if d1 and d2 then
			if math.abs(signedAngle(d1, d2)) > math.rad(2.5) or flatDist(a, b) > 12 then
				out[#out + 1] = b
			end
		end
	end
	out[#out + 1] = points[#points]
	return out
end

local function finalizePath(points, flyover)
	local pts = simplify(points)
	pts = filletPoints(pts, math.clamp(Nav.R * 1.5, 2, 6))
	return buildPath(pts, flyover)
end

