	local function fullDestroy()
		Cfg.Active, Cfg.Manual, Cfg.Destroyed = false, false, true
		_G.AtmHack_Active = false
		pcall(Drive.stopFollow)
		pcall(clearHighlights)
		pcall(Drive.cleanup)
		if genv.__AutoATM and genv.__AutoATM.Destroy == fullDestroy then genv.__AutoATM = nil end
	end

	------------------------------------------------------------
	-- UI
	------------------------------------------------------------
	local Window = WindUI:CreateWindow({
		Title = "Auto ATM Hub",
		Author = "เสกรถ • ขับ • ซื้อชิป • แฮก ATM",
		Icon = "banknote",
		Folder = "AutoATMHub",
		Theme = "Dark",
		Size = UDim2.fromOffset(580, 440),
	})
	if not Window then
		fullDestroy()
		warn("[AutoATM] สร้างหน้าต่าง WindUI ไม่ได้")
		return
	end
	pcall(function()
		Window:OnDestroy(function()
			Cfg.Active, Cfg.Manual, Cfg.Destroyed = false, false, true
			_G.AtmHack_Active = false
			pcall(Drive.stopFollow)
			pcall(clearHighlights)
			pcall(Drive.cleanup)
		end)
	end)

	local function makeLive(tab, title, initial)
		local obj
		pcall(function() obj = tab:Paragraph({ Title = title, Desc = initial }) end)
		if obj and obj.SetDesc then
			return function(text) pcall(obj.SetDesc, obj, text) end
		end
		local inp
		pcall(function() inp = tab:Input({ Title = title, Value = initial, Callback = function() end }) end)
		if inp and inp.Set then
			return function(text) pcall(inp.Set, inp, text) end
		end
		return function() end
	end

	---------------- Tab หลัก ----------------
	local TabMain = Window:Tab({ Title = "หลัก", Icon = "home" })
	local setStatusUI = makeLive(TabMain, "สถานะ", curStatus)
	local setMoneyUI  = makeLive(TabMain, "กระเป๋า / ธนาคาร", "...")
	TabMain:Space()

	mainToggle = TabMain:Toggle({
		Title = "เริ่มระบบอัตโนมัติ",
		Desc = "เสกรถ → เช็กชิป → (ถอน/ซื้อ/ฝาก) → ไป ATM → ลงรถ → แฮก → วนซ้ำ",
		Value = false,
		Callback = function(on)
			if syncing then return end
			if on then startLoop() else stopAll("หยุดแล้ว") end
		end,
	})
	TabMain:Space()
	TabMain:Dropdown({
		Title = "พาหนะ",
		Values = { "car", "bike" },
		Value = Cfg.VehicleType,
		Callback = function(v)
			if v == "car" or v == "bike" then
				Cfg.VehicleType = v
				Veh.reset()
			end
		end,
	})
	TabMain:Dropdown({
		Title = "ชิปที่ใช้แฮก",
		Values = CHIP_LIST,
		Value = Cfg.Chip,
		Callback = function(v)
			if CHIP_PRICE[v] then Cfg.Chip = v end
		end,
	})
	TabMain:Slider({
		Title = "ซื้อชิปต่อรอบ (ชิ้น)",
		Step = 1,
		Value = { Min = 1, Max = 50, Default = Cfg.BuyQty },
