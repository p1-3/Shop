	local function getMoney()
		local m = DataModule and DataModule.money
		if type(m) ~= "table" then return 0, 0 end
		return tonumber(m.hand) or 0, tonumber(m.bank) or 0
	end

	local function fmt(n)
		n = tonumber(n)
		if not n then return "?" end
		local s = tostring(math.floor(n))
		local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		return (out:gsub("^,", ""))
	end

	local function countItem(name)
		local items = DataModule and DataModule.items
		if type(items) ~= "table" then return 0 end
		local want = tostring(name):lower()
		local total = 0
		for _, cat in pairs(items) do
			if type(cat) == "table" then
				for itemName, group in pairs(cat) do
					if tostring(itemName):lower() == want and type(group) == "table" then
						local c = 0
						for _, e in ipairs(group) do
							local q = type(e) == "table" and tonumber(e.amount or e.count or e.quantity or e.stack) or nil
							c += q or 1
						end
						if c == 0 then
							for _, e in pairs(group) do
								if type(e) == "table" then c += 1 end
							end
						end
						total += c
					end
				end
			end
		end
		return total
	end

