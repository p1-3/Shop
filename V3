local undergroundPinConn = nil
local pinnedVehicle      = nil
local pinTargetY         = CONFIG.UndergroundY
Drive._followConn        = nil

local function pinOneVehicle(v)
	if Drive._followConn then return end
	if not v or not v.Parent then return end
	local pivot = v:GetPivot()
	local dy    = pinTargetY - pivot.Position.Y
	if math.abs(dy) > 0.05 then
		v:PivotTo(pivot + Vector3.new(0, dy, 0))
		for _, r in ipairs(collectRoots(v)) do
			r.AssemblyLinearVelocity  = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function refreshUndergroundPin()
	if undergroundPinConn then undergroundPinConn:Disconnect() undergroundPinConn = nil end
	if not CONFIG.UndergroundMode then pinnedVehicle = nil return end
	undergroundPinConn = RunService.Heartbeat:Connect(function()
		if not CONFIG.UndergroundMode then return end
		local cur = getMyVehicle()
		if cur then pinnedVehicle = cur end
		if pinnedVehicle and pinnedVehicle.Parent then pinOneVehicle(pinnedVehicle) end
	end)
end

function Drive.warpVehicleY(vehicle, targetY)
	if not vehicle or not vehicle.Parent then return false end
	if CONFIG.UndergroundMode then pinTargetY = targetY end
	local pivot = vehicle:GetPivot()
	local dy = targetY - pivot.Position.Y
	if math.abs(dy) < 0.05 then return true end
	vehicle:PivotTo(pivot + Vector3.new(0, dy, 0))
	for _, r in ipairs(collectRoots(vehicle)) do
		r.AssemblyLinearVelocity  = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
	end
	return true
end

function Drive.findGroundYAt(x, z, hintY, excludeAtm)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.IgnoreWater = true
	rp.RespectCanCollide = true
	local ex = {}
	local v = getMyVehicle() or pinnedVehicle
	if v then ex[#ex + 1] = v end
	if player.Character then ex[#ex + 1] = player.Character end
	if excludeAtm then ex[#ex + 1] = excludeAtm end
	rp.FilterDescendantsInstances = ex
	local startY = (hintY or 500) + 150
	local r = Workspace:Raycast(Vector3.new(x, startY, z), Vector3.new(0, -400, 0), rp)
	if r then return r.Position.Y end
	return hintY or CONFIG.GroundYFallback
end

function Drive.getATMStandXZ(atm)
	local saved = S.standOverride[atmKey(atm)]
	if saved then return Vector3.new(saved.X, 0, saved.Z) end
	local center, pref, half = atmInfo(atm)
	local baseDist = half + V.L * 0.5 + computeStandGap()
	local x, z = center.X + pref.X * baseDist, center.Z + pref.Z * baseDist
	return Vector3.new(x, 0, z)
end

function Drive.setPinTarget(y) pinTargetY = tonumber(y) or CONFIG.UndergroundY end
function Drive.getPinTarget() return pinTargetY end

function Drive.setUnderground(enabled, y)
	if y then CONFIG.UndergroundY = tonumber(y) or CONFIG.UndergroundY end
	CONFIG.UndergroundMode = enabled and true or false
	refreshUndergroundPin()
	if CONFIG.UndergroundMode then Drive.warpToUnderground() end
end

function Drive.warpToUnderground()
	if not CONFIG.UndergroundMode then return end
	pinTargetY = CONFIG.UndergroundY
	local v = getMyVehicle() or pinnedVehicle
	if v then Drive.warpVehicleY(v, CONFIG.UndergroundY) end
end

