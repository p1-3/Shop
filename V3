	hbConn:Disconnect()
	Drive.stop()
	if undergroundPinConn then undergroundPinConn:Disconnect() undergroundPinConn = nil end
	if safePlatConn then safePlatConn:Disconnect() safePlatConn = nil end
	if safePlatform then safePlatform:Destroy() safePlatform = nil end
	pinnedVehicle = nil
	pcall(function() guideFolder:Destroy() end)
end

