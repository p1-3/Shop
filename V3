	-- Patch C+G: visitATM warp ตรง + startFollow
	local function visitATM(atm)
		say("ขับไป " .. atm.Name)
		if not driveTo(function(v) return Drive.goToATM(v, atm) end) then return false end

		local warpY, vehicleRef
		if Cfg.UndergroundMode then
			vehicleRef = Drive.getMyVehicle()
			if vehicleRef then
				local standXZ = Drive.getATMStandXZ(atm)
				local atmY    = atm:GetPivot().Position.Y
				local groundY = Drive.findGroundYAt(standXZ.X, standXZ.Z, atmY, atm) or atmY
				warpY = groundY + 2
				local curPivot = vehicleRef:GetPivot()
				vehicleRef:PivotTo(CFrame.new(standXZ.X, warpY, standXZ.Z) * (curPivot - curPivot.Position))
				Drive.setPinTarget(warpY)
				task.wait(0.3)
			end
		end

		if not exitSeat() then
			say("ลงจากรถไม่สำเร็จ — ลองใหม่")
			task.wait(0.4)
			if not exitSeat() then
				say("ลงจากรถไม่สำเร็จอีก — warp ลง + ข้ามตู้นี้")
				if vehicleRef and Cfg.UndergroundMode then
					Drive.warpVehicleY(vehicleRef, Cfg.UndergroundY)
				end
				return false
			end
		end

		-- Patch G: follow mode
		if vehicleRef and warpY then
			Drive.startFollow(vehicleRef, warpY, atm, 4)
		end

		return true
	end

	local function hackAt(atm)
		if not alive() then return end
		say("กำลังแฮก " .. atm.Name .. " ด้วย " .. Cfg.Chip)
		local seen = Hack.run(Cfg.Chip, atm)
		Drive.stopFollow()
		badUntil[Drive.atmKey(atm)] = os.clock() + (seen and 5 or 20)
		readyCache[Drive.atmKey(atm)] = { ready = false, t = os.clock() }
		if seen then
			stats.hacks += 1
			say("แฮกเสร็จ (รวม " .. stats.hacks .. " ครั้ง)")
		else
			say("แฮกไม่สำเร็จ — จะลองตู้อื่นที่พร้อม")
		end
	end

	local function cycle()
		if not Veh.ensureSeated() then task.wait(1.5) return end
		if Cfg.UndergroundMode then Drive.warpToUnderground() end

		local chip = Cfg.Chip
		if countItem(chip) <= 0 then
			local qty = math.max(1, math.floor(Cfg.BuyQty))
			local cost = (CHIP_PRICE[chip] or 0) * qty
			local hand, bank = getMoney()
			say(("ไม่มี %s • ซื้อ %d ชิ้น = $%s (มือ $%s / ธนาคาร $%s)"):format(chip, qty, fmt(cost), fmt(hand), fmt(bank)))

			if hand + bank < cost then
				stopAll(("เงินรวมไม่พอซื้อ %s ×%d"):format(chip, qty))
				return
			end

			if hand < cost then
				local atm = pickATM(myPos(), false)
				if not atm then stopAll("ไม่พบตู้ ATM") return end
				if not visitATM(atm) then return end
				local need = math.ceil(cost - hand)
				say("ถอนเงิน $" .. fmt(need))
				if not Bank.withdraw(need) then stopAll("ถอนเงินไม่สำเร็จ") return end
				task.wait(0.5)
				if not Veh.ensureSeated() then return end
				if Cfg.UndergroundMode then Drive.warpToUnderground() end
			end

			say("ขับไปจุดซื้อชิป")
			if not driveTo(function(v) return Drive.goToPoint(v, Cfg.ShopPoint, "จุดซื้อชิป") end) then return end

			if Cfg.UndergroundMode then
				local vehicle = Drive.getMyVehicle()
				if vehicle then
					local shopXZ = Vector3.new(Cfg.ShopPoint.X, 0, Cfg.ShopPoint.Z)
					local groundY = Drive.findGroundYAt(shopXZ.X, shopXZ.Z, Cfg.ShopPoint.Y) or Cfg.ShopPoint.Y
					local warpY   = groundY + 2
					local curPivot = vehicle:GetPivot()
					vehicle:PivotTo(CFrame.new(shopXZ.X, warpY, shopXZ.Z) * (curPivot - curPivot.Position))
					Drive.setPinTarget(warpY)
					task.wait(0.4)
				end
			end

			exitSeat()
			local shop
			waitUntil(function()
				shop = Workspace:FindFirstChild("ShopZone_Illegal")
				return shop ~= nil
			end, 5)
			if not shop then stopAll("ไม่พบ workspace.ShopZone_Illegal") return end

			local got = Bank.buy(chip, qty, shop)
			if got <= 0 then
				buyFails += 1
				if buyFails >= 2 then stopAll("ซื้อชิปไม่ผ่าน 2 ครั้ง") end
				return
			end
			buyFails = 0
			say(("ซื้อได้ %d/%d ชิ้น"):format(got, qty))

			local leftover = math.floor((getMoney()) - Cfg.KeepOnHand)
			if Cfg.AutoDeposit and leftover > 0 then
				local atm = pickATM(myPos(), false)
				if atm and visitATM(atm) then
					say("ฝากเงินที่เหลือ $" .. fmt(leftover))
					if not Bank.deposit(leftover) then
						notify("ฝากเงินไม่สำเร็จ", "ข้ามไปแฮกต่อ")
					end
					task.wait(0.5)
					if atmReadyLive(atm) then
						hackAt(atm)
						return
					end
				end
			end
		end

		if not alive() then return end
		local atm = pickATM(myPos(), true)
		if not atm then
			say("ไม่มีตู้ที่พร้อมแฮก (แดงทุกตู้) รอสักครู่...")
			task.wait(2)
			return
		end
		if not visitATM(atm) then return end
		if not waitUntil(function() return atmReadyLive(atm) end, 2.5) then
			local key = Drive.atmKey(atm)
			badUntil[key] = os.clock() + 10
			readyCache[key] = { ready = false, t = os.clock() }
			say(atm.Name .. " ยังไม่พร้อม (แดง) — ไปตู้อื่น")
			return
		end
		hackAt(atm)
	end

