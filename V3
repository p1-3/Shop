local function getATMFolder()
	local map = Workspace:FindFirstChild("Map")
	local props = map and map:FindFirstChild("Props")
	return props and props:FindFirstChild("ATMs")
end

local function collectATMs()
	local list = {}
	local folder = getATMFolder()
	if not folder then return list end
	local function scan(parent)
		for _, c in ipairs(parent:GetChildren()) do
			if c:IsA("Model") or c:IsA("BasePart") then
				list[#list + 1] = c
			elseif c:IsA("Folder") then
				scan(c)
			end
		end
	end
	scan(folder)
	return list
end

local function atmKey(a)
	local p = a:GetPivot().Position
	return ("%s@%d,%d"):format(a.Name, math.floor(p.X + 0.5), math.floor(p.Z + 0.5))
end

local function nextATM(fromPos)
	local list = collectATMs()
	S.totalCount = #list
	local best, bestD
	for _, a in ipairs(list) do
		if not S.visited[atmKey(a)] then
			local d = flatDist(a:GetPivot().Position, fromPos)
			if not bestD or d < bestD then best, bestD = a, d end
		end
	end
	return best, #list
end

local function atmInfo(atm)
	local cf, size
	if atm:IsA("Model") then
		cf, size = atm:GetBoundingBox()
	else
		cf, size = atm.CFrame, atm.Size
	end
	local center = cf.Position
	local look = flatUnit(atm:GetPivot().LookVector) or Vector3.new(0, 0, -1)
	local pref
	if frontMode then
		pref = rotY(look, math.rad(frontMode))
	else
		for _, d in ipairs(atm:GetDescendants()) do
			local pp
			if d:IsA("ProximityPrompt") then
				local par = d.Parent
				if par and par:IsA("BasePart") then
					pp = par.Position
				elseif par and par:IsA("Attachment") then
					pp = par.WorldPosition
				end
			elseif d:IsA("BasePart") then
				local l = d.Name:lower()
				if l:find("screen") or l:find("display") or l:find("keypad") or l:find("monitor") then
					pp = d.Position
				end
			end
			if pp and flatDist(pp, center) > 0.4 then
				pref = flatUnit(pp - center)
				break
			end
		end
		pref = pref or look
	end
	return center, pref, math.max(size.X, size.Z) * 0.5, center.Y - size.Y * 0.5
end

local function computeStandGap()
	return CONFIG.StandGap + math.max(0, V.L - 5) * 0.4
end

local function computeStand(atm, vehicle)
	if CONFIG.UndergroundMode then
		local saved = S.standOverride[atmKey(atm)]
		local center, pref, half = atmInfo(atm)
		local baseDist = half + V.L * 0.5 + computeStandGap()
		if saved then return Vector3.new(saved.X, CONFIG.UndergroundY, saved.Z), "saved" end
		local x, z = center.X + pref.X * baseDist, center.Z + pref.Z * baseDist
		return Vector3.new(x, CONFIG.UndergroundY, z), "underground"
	end
	local saved = S.standOverride[atmKey(atm)]
	if saved then return saved, "saved" end
	local center, pref, half, bottomY = atmInfo(atm)
	local baseDist = half + V.L * 0.5 + computeStandGap()
	local exclude = { vehicle, atm }
	if player.Character then table.insert(exclude, player.Character) end
	if CONFIG.ThroughDoors then
		for _, d in ipairs(Nav.doors) do exclude[#exclude + 1] = d end
	end
	local clearParams = RaycastParams.new()
	clearParams.FilterType = Enum.RaycastFilterType.Exclude
	clearParams.FilterDescendantsInstances = exclude
	clearParams.IgnoreWater = true
	clearParams.RespectCanCollide = true
	local function tryAt(dir, dist)
		local x, z = center.X + dir.X * dist, center.Z + dir.Z * dist
		local fy = floorAt(x, z, bottomY)
		if not fy or math.abs(fy - bottomY) > CONFIG.MaxStep + 0.5 then return nil end
		local o = Vector3.new(center.X, fy + 2.5, center.Z)
		local t = Vector3.new(x, fy + 2.5, z)
		if Workspace:Raycast(o, t - o, clearParams) then return nil end
		if not volumeFree(x, z, fy) then return nil end
		return Vector3.new(x, fy, z)
	end
	local order = {
		{ 0, { 0, 1.5, 3, 4.5, 6.5 }, "front" },
		{ 90, { 0, 2, 4 }, "side" },
		{ -90, { 0, 2, 4 }, "side" },
		{ 180, { 0, 2, 4 }, "back" },
	}
	for _, o in ipairs(order) do
		local dir = rotY(pref, math.rad(o[1]))
		for _, extra in ipairs(o[2]) do
			local p = tryAt(dir, baseDist + extra)
			if p then return p, o[3] end
		end
	end
	local x, z = center.X + pref.X * baseDist, center.Z + pref.Z * baseDist
	return Vector3.new(x, floorAt(x, z, bottomY) or bottomY, z), "weak"
end

local function recordStand()
	local vehicle = getMyVehicle()
	local pos
	if vehicle then
		pos = vehicle:GetPivot().Position
	else
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		pos = root and root.Position
	end
	if not pos then setStatus("📍 ไม่พบตำแหน่ง") return end
	local best, bestD
	for _, a in ipairs(collectATMs()) do
		local d = flatDist(a:GetPivot().Position, pos)
		if not bestD or d < bestD then best, bestD = a, d end
	end
	if not best or bestD > 60 then
		setStatus("📍 ไม่มีตู้ใกล้ (ต้องอยู่ในระยะ 60 studs)")
		return
	end
	local ex = {}
	if vehicle then ex[#ex + 1] = vehicle end
	if player.Character then ex[#ex + 1] = player.Character end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = ex
	rp.IgnoreWater = true
	rp.RespectCanCollide = true
	local r = Workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -40, 0), rp)
	local fy = r and r.Position.Y or (pos.Y - (vehicle and hoverNow() or 3))
	local v = Vector3.new(pos.X, fy, pos.Z)
	local key = atmKey(best)
	S.standOverride[key] = v
	print(('["%s"] = Vector3.new(%.2f, %.2f, %.2f),'):format(key, v.X, v.Y, v.Z))
	setStatus(("📍 จำจุดจอด %s แล้ว"):format(best.Name))
end

